#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n,m;
	    cin>>n>>m;
	    int count=0 ,count2=0,ans=0;
	    string s[n],l[m];
	    for(int i=0;i<n;i++){
	        cin>>s[i];
	    }
	    for(int i=0;i<m;i++){
	        cin>>l[i];
	    }
	    for(int i=0;i<n;i++){
	        for(int j=0;j<m;j++)
	        if(s[i]==l[j]){
	            count2=0;
	            count++;
	            ans=max(count,ans);
	        }else{
	            count=0;
	            count2++;
	            ans=max(count2,ans);
	            
	        }
	    }
	    cout<<ans<<endl;
	}

}
