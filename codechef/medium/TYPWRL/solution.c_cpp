#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, m;
        cin >> n >> m;

        string s, l;
        cin >> s >> l;

        int count = 0, ans = 0;
        bool prevLeft = false;

        for (int i = 0; i < n; i++) {
            bool left = false;

            for (int j = 0; j < m; j++) {
                if (s[i] == l[j]) {
                    left = true;
                    break;
                }
            }

            if (i == 0 || left != prevLeft)
                count = 1;
            else
                count++;

            prevLeft = left;
            ans = max(ans, count);
        }

        cout << ans << '\n';
    }
}