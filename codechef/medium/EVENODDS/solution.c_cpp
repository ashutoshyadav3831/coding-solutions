#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int a[n];
	    vector<int>v;
	    for(int i=0;i<n;i++){
	        cin>>a[i];
	    }
	  int  oddcount=0;
	  for(int i=0;i<n;i++){
	      if(a[i]%2==1){
	          oddcount++;
	      }
	  }
	  if(oddcount==0){
	      cout<<n<<endl;
	  }elseif(oddcount%2==0){
	      cout<<n<<endl;
	  }else{
	      
	      for(int i=0;i<n;i++){
	          if(a[i]%2==1){
	              v.push_back(i);
	          }
	      }
	  }
	  
	}

}
