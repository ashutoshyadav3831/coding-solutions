#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector <int> a(n);
	    for(int i=0;i<n;i++){
	        cin>>a[i];
	    }
	    int count=0;
	    for(int i=0;i<n;i++){
	        count=count+a[i];
	    }
	    int extra=INT_MAX;
	    for(int i = 0; i < n-1; i++){
          extra = min(a[i] + a[i+1], extra);
        }
	    cout<<count-extra/2<<endl;
	}

}
