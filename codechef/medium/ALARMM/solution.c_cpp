#include <bits/stdc++.h>
using namespace std;
void solve () {
    int n , k ; cin >> n >> k ; 
    string s ; cin >> s ; 
    
    int answer = 0 ; 
    int last = 0 ; 
    int right = s.size()  ; 
     
    while(right >= 0 ) {
        int calc = max (1 , right - k ) ; 
        if (s[right-1] == '1' ) {
            right = calc ; 
            answer ++ ;
            continue ; 
        }
        right -- ; 
    }
    
    cout << answer << '\n' ; 
    
}

int main() {
	// your code goes here
	
	int t ; cin >> t ; 
	while(t--) solve () ; 

}
