#include <bits/stdc++.h>
using namespace std;
void solve () {
    int n , k ; cin >> n >> k ; 
    string s ; cin >> s ; 
    
    int answer = 0 ; 
    int last = 0 ; 
    for(int i =0  ; i<s.size() ;++i) {
        int rough = max (1,i-k) ; 
        if (s[i] == '1' && rough <= last ) {
            last = i + 1 ; 
            answer ++ ; 
        }
    }
}

int main() {
	// your code goes here
	
	int t ; cin >> t ; 
	while(t--) solve () ; 

}
