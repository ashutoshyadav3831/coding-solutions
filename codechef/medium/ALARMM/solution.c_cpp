#include <bits/stdc++.h>
using namespace std;
void solve () {
    int n , k ; cin >> n >> k ; 
    string s ; cin >> s ; 
    
    int i = n; int answer = 0; 
    
    while(i < s.size() ) {
        if (s[i] == '1') {
            answer ++ ;
            if (k == 0 ) i++ ; continue ; 
            i = i + k ;
            }
        else i++   ; 
    }
    
    cout << answer << endl ; 
}
    
    
int main () {
    int t ; cin >> t ; 
    while(t--) solve () ; 
}

