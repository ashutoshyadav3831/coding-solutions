#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    string s;
	    cin>>s;
	    vector<char>v;
	    for(int i=0;i<n;i++){
	        if(i==0){
	            v.push_back(s[i]);
	            
	        }else if(s[i]==s[i-1]){
	            continue;
	        }else{
	            v.push_back(s[i]);
	        }
	    }
	    if(k >= v.size() && k <= n){
	        cout<<"Yes\n";
	    }else{
	        cout<<"No\n";
	    }
	}

}
