#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    vector<int> a(n);
	    for(int i=0;i<n;i++){
	        cin>>a[i];
	    }
	    sort(a.begin(),a.end());
	    if(k>n){
	        k=n;
	    }
	    int total=0;
	    int i=n-1;
	    while(k){
	        total+=a[i];
	        i--;
	        k--;
	    }
	    cout<<total<<endl;
	}

}
