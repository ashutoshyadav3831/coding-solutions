#include <bits/stdc++.h>
using namespace std;

int main() {
    int x, k, y;
    cin >> x >> k >> y;

    bool xy = false;
    int originalK = k;

    for (int i = 1; i <= x; i++) {
        if (y == k) {
            xy = true;
            break;
        }
        k = k + originalK;
    }

    if (xy) {
        cout << "yes\n";
    } else {
        cout << "no\n";
    }

    return 0;
}