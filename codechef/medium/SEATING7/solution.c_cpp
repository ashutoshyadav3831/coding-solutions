#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n,m,k;
	    cin>>n>>m>>k;
	    int a[m];
	    int count =0;
	    for(int i=0;i<m;i++){
	        cin>>a[i];
	    }
	    int j=0;
	    for(int i=1;i<=n;i++){
	        if(i==a[j]){
	            j++;
	            continue;
	        }else{
	            cout<<i<<" ";
	            count++;
	        }
	        if(count==k){
	            cout<<endl;
	            break;
	        }
	    }
	}

}
